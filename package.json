{
    "name": "crdt-next-poc",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "concurrently -k -n \"next,collab\" -c \"cyan,magenta\" \"next dev\" \"tsx server/src/index.ts\"",
        "dev:next": "next dev",
        "collab:dev": "tsx server/src/index.ts",
        "build": "prisma generate && next build",
        "start": "next start",
        "lint": "eslint",
        "format": "prettier --write .",
        "type-check": "tsc --noEmit",
        "prepare": "husky",
        "postinstall": "prisma generate",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.11.3",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "@prisma/extension-accelerate": "^3.0.1",
        "@t3-oss/env-nextjs": "^0.13.11",
        "@tiptap/core": "^2.27.2",
        "@tiptap/extension-bubble-menu": "^2.27.2",
        "@tiptap/extension-character-count": "^2.27.2",
        "@tiptap/extension-code-block-lowlight": "^2.27.2",
        "@tiptap/extension-collaboration": "^2.27.2",
        "@tiptap/extension-collaboration-cursor": "^2.26.2",
        "@tiptap/extension-highlight": "^2.27.2",
        "@tiptap/extension-image": "^2.27.2",
        "@tiptap/extension-link": "^2.27.2",
        "@tiptap/extension-placeholder": "^2.27.2",
        "@tiptap/extension-table": "^2.27.2",
        "@tiptap/extension-table-cell": "^2.27.2",
        "@tiptap/extension-table-header": "^2.27.2",
        "@tiptap/extension-table-row": "^2.27.2",
        "@tiptap/extension-task-item": "^2.27.2",
        "@tiptap/extension-task-list": "^2.27.2",
        "@tiptap/extension-text-align": "^2.27.2",
        "@tiptap/extension-underline": "^2.27.2",
        "@tiptap/pm": "^2.27.2",
        "@tiptap/react": "^2.27.2",
        "@tiptap/starter-kit": "^2.27.2",
        "@tiptap/suggestion": "^2.27.2",
        "bcryptjs": "^3.0.3",
        "clsx": "^2.1.1",
        "dotenv": "^17.4.2",
        "lowlight": "^3.3.0",
        "lucide-react": "^1.34.0",
        "next": "16.3.1",
        "next-auth": "^5.0.0-beta.32",
        "nodemailer": "^8.0.11",
        "pg": "^8.23.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "tailwind-merge": "^3.6.0",
        "ws": "^8.21.3",
        "y-indexeddb": "^9.0.12",
        "y-protocols": "^1.0.7",
        "y-websocket": "^2.1.0",
        "yjs": "^13.6.32",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "^4",
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^20.19.43",
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.23.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/ws": "^8.18.1",
        "concurrently": "^10.0.5",
        "eslint": "^9",
        "eslint-config-next": "16.3.1",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "prisma": "^7.9.1",
        "tailwindcss": "^4",
        "tsx": "^4.23.12",
        "typescript": "^5"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md,mjs}": [
            "prettier --write"
        ]
    }
}
