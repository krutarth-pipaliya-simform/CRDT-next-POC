# Standard Postgres connection string (for running migrations locally)
# DIRECT_URL="postgresql://postgres:password@host/crdt_next_poc"

# Prisma Accelerate connection string (used by the client)
# For local dev without accelerate, this can be the direct Postgres URL. 
# With Prisma Accelerate, it should start with prisma://
DATABASE_URL="postgresql://postgres:password@host:5432/crdt_next_poc"

AUTH_SECRET="your-secret-key-here"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NEXT_PUBLIC_WS_URL="ws://localhost:8080"
