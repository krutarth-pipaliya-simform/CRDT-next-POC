# Transactional connection pool URL (used by Prisma Client)
# E.g. PgBouncer pool connection or Prisma Accelerate (prisma://)
DATABASE_URL="postgresql://postgres:password@host:6543/crdt_next_poc?pgbouncer=true"

# Direct connection URL (used for migrations and schema push)
# Must be a direct connection to the database
DIRECT_URL="postgresql://postgres:password@host:5432/crdt_next_poc"
AUTH_SECRET="your-secret-key-here"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NEXT_PUBLIC_WS_URL="ws://localhost:8080"

# Email Configuration (Nodemailer)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@example.com"
EMAIL_SERVER_PASSWORD="your-email-password"

# GitHub OAuth
AUTH_GITHUB_ID="your_github_client_id"
AUTH_GITHUB_SECRET="your_github_client_secret"
