datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MEMBER
  GUEST
}

// --- Auth.js Models ---
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?

  // TODO(Tech-Debt): Remove this global 'role' field in the future.
  // Roles (ADMIN, MEMBER, GUEST) belong to WorkspaceMember, not User.
  // This was temporarily added for testing purposes.
  role          Role      @default(MEMBER)

  accounts      Account[]
  sessions      Session[]
  workspaces    WorkspaceMember[]
  invitationsCreated WorkspaceInvitation[]
  messages      Message[]
  chatReadCursors    ChatReadCursor[]
  notifications      Notification[] @relation("NotificationRecipient")
  notificationsActed Notification[] @relation("NotificationActor")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum WorkspaceVisibility {
  PUBLIC
  PRIVATE
}

/// Board columns in order: Backlog, To Do, In Progress, Review, Completed.
/// `DONE` is labelled "Completed"; the value keeps its name so existing rows
/// and the completion notification need no rewrite.
enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  DOCUMENT_CREATED
  MEMBER_JOINED
  MENTION
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// --- Domain Models ---
model Workspace {
  id          String              @id @default(cuid())
  name        String
  visibility  WorkspaceVisibility @default(PRIVATE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  members     WorkspaceMember[]
  documents   Document[]
  tasks       Task[]
  invitations WorkspaceInvitation[]
  messages    Message[]
  chatReadCursors ChatReadCursor[]
  notifications Notification[]
  subscription Subscription?
}

model WorkspaceInvitation {
  id          String    @id @default(cuid())
  workspaceId String
  token       String    @unique @default(cuid())
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId])
}

model WorkspaceMember {
  id            String    @id @default(cuid())
  workspaceId   String
  userId        String
  role          Role      @default(MEMBER)
  /// When the person joined; drives the analytics "user growth" series.
  joinedAt      DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks Task[]

  @@index([workspaceId, joinedAt])
}

model Document {
  id          String    @id @default(cuid())
  title       String    @default("Untitled Document")
  content     Bytes?    // Yjs binary state
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Task {
  id          String           @id @default(cuid())
  title       String
  description String?
  status      TaskStatus       @default(TODO)
  priority    TaskPriority     @default(MEDIUM)
  position    Float            @default(0)
  dueDate     DateTime?
  assigneeId  String?
  workspaceId String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assignee    WorkspaceMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([assigneeId])
}

model Message {
  id          String    @id @default(cuid())
  body        String    @db.Text
  workspaceId String
  authorId    String
  createdAt   DateTime  @default(now())

  /// One optional shared file per message (FR-11). The bytes live in upload
  /// storage under `chat/`; the row keeps what the bubble needs to render it.
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

/// Read receipts (FR-11): how far each member has read the workspace channel.
/// One row per person per channel rather than per message, so marking a
/// channel read is a single upsert and "seen by" is a timestamp comparison.
model ChatReadCursor {
  workspaceId String
  userId      String
  lastReadAt  DateTime
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  body        String?
  href        String?
  workspaceId String
  recipientId String
  actorId     String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([workspaceId, recipientId, createdAt])
}

model Subscription {
  id                   String             @id @default(cuid())
  workspaceId          String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  cancelAtPeriodEnd    Boolean            @default(false)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
}

/// Idempotency ledger for Stripe webhooks. Stripe retries deliveries, so every
/// event id is recorded before it is applied and replays are dropped on sight.
model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
