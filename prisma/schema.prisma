datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MEMBER
  GUEST
}

// --- Auth.js Models ---
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?

  // TODO(Tech-Debt): Remove this global 'role' field in the future.
  // Roles (ADMIN, MEMBER, GUEST) belong to WorkspaceMember, not User.
  // This was temporarily added for testing purposes.
  role          Role      @default(MEMBER)

  accounts      Account[]
  sessions      Session[]
  workspaces    WorkspaceMember[]
  invitationsCreated WorkspaceInvitation[]
  joinRequests  WorkspaceJoinRequest[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum WorkspaceVisibility {
  PUBLIC
  PRIVATE
  ORGANIZATION
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// --- Domain Models ---
model Workspace {
  id          String              @id @default(cuid())
  name        String
  visibility  WorkspaceVisibility @default(PRIVATE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  members     WorkspaceMember[]
  documents   Document[]
  tasks       Task[]
  invitations WorkspaceInvitation[]
  joinRequests WorkspaceJoinRequest[]
}

model WorkspaceInvitation {
  id          String    @id @default(cuid())
  workspaceId String
  token       String    @unique @default(cuid())
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId])
}

model WorkspaceJoinRequest {
  id          String            @id @default(cuid())
  workspaceId String
  userId      String
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        Role      @default(MEMBER)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id          String    @id @default(cuid())
  title       String    @default("Untitled Document")
  content     Bytes?    // Yjs binary state
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("TODO")
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
