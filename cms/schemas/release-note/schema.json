{
    "kind": "collectionType",
    "collectionName": "release_notes",
    "info": {
        "singularName": "release-note",
        "pluralName": "release-notes",
        "displayName": "Release note",
        "description": "Release notes for one version"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "version": {
            "type": "string",
            "required": true
        },
        "title": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "uid",
            "targetField": "title",
            "required": true
        },
        "releaseDate": {
            "type": "date",
            "required": true
        },
        "summary": {
            "type": "text",
            "maxLength": 300
        },
        "body": {
            "type": "blocks",
            "required": true
        }
    }
}
