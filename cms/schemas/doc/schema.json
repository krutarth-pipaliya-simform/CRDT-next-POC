{
    "kind": "collectionType",
    "collectionName": "docs",
    "info": {
        "singularName": "doc",
        "pluralName": "docs",
        "displayName": "Doc",
        "description": "Documentation page"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "title": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "uid",
            "targetField": "title",
            "required": true
        },
        "section": {
            "type": "string",
            "required": true
        },
        "order": {
            "type": "integer",
            "default": 0
        },
        "summary": {
            "type": "text",
            "maxLength": 300
        },
        "body": {
            "type": "blocks",
            "required": true
        }
    }
}
